Screen {
    layout: horizontal;
}

.filetree {
    height: 100%;
    width: 30%;
    border: yellow;
}

.borderless {
    margin: 0 1;
}

.preview {
    height: 100%;
    width: 70%;
    border: yellow;
}

Button {
    margin: 0 1;
    width: 100%
}

QuitScreen {
    align: center middle;
}

ConnectScreen {
    align: center middle;
}

#connectdialog {
    grid-size: 1;
    grid-gutter: 1 2;
    padding: 0 1;
    width: 60;
    border: thick $background 80%;
    background: $surface;
}

#dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
    background: $surface;
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}